{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-copilot-enhanced@0.1.9",
    "opencode-content-filter@0.1.1",
    "opencode-keystone@0.3.15",
    "copilot-second-opinion@0.6.0"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.secrets/context7-key}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.enterprise.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {file:~/.secrets/github-copilot-token}"
      }
    },
    "binja-lattice": {
      "type": "local",
      "command": [
        "/home/adam/.local/share/binja-lattice-mcp/.venv/bin/python",
        "/home/adam/.local/share/binja-lattice-mcp/mcp_server.py"
      ],
      "cwd": "/home/adam/.local/share/binja-lattice-mcp",
      "environment": {
        "BNJLAT": "{file:~/.secrets/binja-lattice-key}"
      }
    },
    "crucible": {
      "type": "local",
      "command": [
        "/home/adam/.nvm/versions/node/v22.21.1/bin/crucible",
        "mcp",
        "--stdio"
      ]
    }
  },
  "lsp": false,
  "provider": {
    "github-copilot": {}
  }
}
