{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-copilot-enhanced@0.1.8",
    "opencode-content-filter@0.1.1",
    "opencode-keystone@0.3.14",
    "copilot-second-opinion@0.5.0"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.secrets/context7-key}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.enterprise.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {file:~/.secrets/github-copilot-token}"
      }
    },
    "crucible": {
      "type": "local",
      "command": [
        "/home/adam/Desktop/crucible/scripts/opencode-mcp.sh"
      ],
      "cwd": "/home/adam/Desktop/crucible",
      "environment": {
        "CRUCIBLE_GUEST_BASE_URL": "https://127.0.0.1:8443",
        "CRUCIBLE_GUEST_CA_PATH": "/home/adam/Desktop/crucible/artifacts/secrets/crucible-win11/mtls/ca.cert.pem",
        "CRUCIBLE_GUEST_CERT_PATH": "/home/adam/Desktop/crucible/artifacts/secrets/crucible-win11/mtls/host-client.cert.pem",
        "CRUCIBLE_GUEST_KEY_PATH": "/home/adam/Desktop/crucible/artifacts/secrets/crucible-win11/mtls/host-client.key.pem"
      }
    }
  },
  "lsp": false,
  "provider": {
    "github-copilot": {}
  }
}
